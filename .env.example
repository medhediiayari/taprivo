NODE_ENV=development

POSTGRES_USER=taprivo
POSTGRES_PASSWORD=taprivo_dev
POSTGRES_DB=taprivo
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=3000
WEB_PORT=8080

JWT_SECRET=replace-with-64-hex-chars-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-with-64-hex-chars-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
QR_HMAC_SECRET=replace-with-64-hex-chars-cccccccccccccccccccccccccccccccccccccc
NFC_HMAC_SECRET=replace-with-64-hex-chars-dddddddddddddddddddddddddddddddddddd

# Session lifetimes. ACCESS_TTL accepts any jsonwebtoken duration (e.g. 15m, 1h).
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# When true, authenticated requests must send an X-Device-Id header matching
# the device the access token was issued for (anti account-sharing).
ENFORCE_DEVICE_BINDING=false

CORS_ORIGIN=http://localhost:8080
VITE_API_URL=/api

# Public HTTPS base URL of the backend (used for absolute logo URLs in wallet
# passes). Leave empty locally; logos are then omitted from passes.
PUBLIC_BASE_URL=

# --- Google Wallet (optional) ---
# From the Google Pay & Wallet Console. /wallet routes return 503 until set.
GOOGLE_WALLET_ISSUER_ID=
# Path to the service-account JSON key (mounted into the backend container).
GOOGLE_WALLET_SA_FILE=/app/secrets/google-wallet-sa.json
# ...or paste the JSON inline instead of using a file (takes precedence):
# GOOGLE_WALLET_SA_JSON=
